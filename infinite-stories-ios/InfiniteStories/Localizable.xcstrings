  "strings": {
    "": {},
    "*": {
      "comment": "A separator symbol used in the event list.",
      "isCommentAutoGenerated": true
    },
    "%@ tab": {
      "comment": "The label for the \"Home\" tab in the tab bar.",
      "isCommentAutoGenerated": true
    },
    "%@, %@": {
      "comment": "An accessibility label that combines the hero's name with a description of its traits.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "%lld": {
      "comment": "A badge displaying the number of stories in the user's story library.",
      "isCommentAutoGenerated": true
    },
    "%lld %@": {
      "comment": "A stat card that displays the number of new stories in the library. The label is set to the localized string \"library.stats.new\". The argument is the string “library.stats.new”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld %2$@"
          }
        }
      }
    },
    "%lld %@ created": {
      "comment": "A caption displaying the number of heroes the user has created. The argument is the count of heroes.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld %2$@ created"
          }
        }
      }
    },
    "%lld/%lld": {
      "comment": "A text displaying the number of unlocked milestones out of the total. The first argument is the count of unlocked milestones. The second argument is the total count of milestones.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld/%2$lld"
          }
        }
      }
    },
    "%lld%%": {},
    "%lldm": {
      "comment": "A label that displays the duration of a story in minutes and a speaker icon. The argument is the duration of the story in minutes.",
      "isCommentAutoGenerated": true
    },
    "%lldmin": {
      "comment": "A label that displays the duration of a story's audio in minutes and a play button. The argument is the duration of the audio in minutes.",
      "isCommentAutoGenerated": true
    },
    "•": {
      "comment": "A separator between different pieces of information in a list.",
      "isCommentAutoGenerated": true
    },
    "• %@": {},
    "+%lld": {},
    "0 Heroes (Empty State)": {
      "comment": "A menu item that sets the hero count to 0, triggering an empty state.",
      "isCommentAutoGenerated": true
    },
    "1": {},
    "1 Hero (Expanded)": {
      "comment": "A button that sets the hero count to 1, causing the hero grid to expand to show all details of a single hero.",
      "isCommentAutoGenerated": true
    },
    "1.0.1": {},
    "2": {},
    "2 Heroes (Expanded)": {
      "comment": "A button that sets the hero count to 2, causing the hero grid to expand to two columns.",
      "isCommentAutoGenerated": true
    },
    "3": {},
    "3 Heroes (2 Column Grid)": {
      "comment": "A button that sets the hero count to 3, causing the adaptive hero grid to display with two columns.",
      "isCommentAutoGenerated": true
    },
    "4 Heroes (2 Column Grid)": {
      "comment": "A button that sets the hero count to 4, causing the adaptive hero grid to display with 2 columns.",
      "isCommentAutoGenerated": true
    },
    "5": {},
    "5+ Heroes (Compact Grid)": {
      "comment": "A button that sets the hero count to 5, triggering a compact grid layout.",
